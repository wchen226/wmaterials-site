---
import Site from '../layouts/Site.astro';
import publications from '../data/publications.json';
import news from '../data/news.json';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import publicationImages from '../data/publication-images.json';
const figures: Record<string, (typeof publicationImages)[keyof typeof publicationImages]> = publicationImages;
const figureAssets = import.meta.glob<{ default: ImageMetadata }>('../assets/publications/*.{png,jpg}', { eager: true });
const groups = [{id:'complex',name:'Complex alloys & ceramics'},{id:'informatics',name:'AI & materials informatics'},{id:'energy',name:'Energy & critical materials'}];
function initials(name:string) {
 if(name.includes(',') || name === 'Wei Chen' || name === 'Wen Chen') return name;
 const words=name.split(' '); return words.length>1 ? words.slice(0,-1).map(x=>x[0]+'.').join('')+' '+words.at(-1) : name;
}
---
<Site title="Publications | Wei Chen" description="Selected publications by Wei Chen, organized by research area: complex alloys and ceramics, AI and materials informatics, and energy and critical materials.">
<div class="wrap pub-hero"><p class="eyebrow">THE PUBLISHED WORK</p><h1>Publications</h1><p>A selection of recent and foundational studies, organized by research area. Each citation links directly to the published paper.</p><div class="actions"><a class="text-link" href="https://scholar.google.com/citations?hl=en&user=pYM2BqsAAAAJ">Full record on Google Scholar ↗</a><a class="text-link" href="https://orcid.org/0000-0002-1135-7721">ORCID ↗</a></div></div>
<div class="wrap pub-layout"><nav class="pub-sidebar" aria-label="Publication research areas"><p>JUMP TO A RESEARCH AREA</p>{groups.map(g=><a href={'#'+g.id}>{g.name}</a>)}<a href="/#research">Research overview ↗</a></nav><div>
{groups.map(g=><section class="pub-group" id={g.id}><h2>{g.name}</h2>{publications.filter(p=>p.group===g.id).sort((a,b)=>b.year-a.year).map(p=>{
 const coverage = news.find(s=>s.doi===p.doi);
 const figure = figures[p.doi];
 const asset = figure && figureAssets[`../assets/publications/${figure.asset}`]?.default;
 return <article class:list={['pub-row', {'has-figure': !!asset}]}>
 <span class="pub-year">{p.year}</span>
 {asset && <figure class="pub-figure">
   <a class="pub-thumbnail" href={figure.sourceUrl} target="_blank" rel="noopener" aria-label={`View Figure 1 and caption for ${p.title} (opens in a new tab)`}>
     <Image src={asset} width={640} widths={[320,640]} sizes="(max-width: 760px) 320px, 200px" format="webp" alt={figure.alt} loading="lazy" decoding="async" />
   </a>
   <figcaption><a href={figure.sourceUrl}>{figure.caption}</a></figcaption>
 </figure>}
 <div class="pub-citation"><h3><a href={'https://doi.org/'+p.doi}>{p.title}</a></h3><p class="pub-authors">{p.authors.map(initials).join(', ')}</p><p class="pub-journal"><em>{p.journal}</em>{p.volume && `, ${p.volume}`}{p.issue && `(${p.issue})`}{p.pages && `, ${p.pages}`}.</p>{p.note && <p class="pub-authors">{p.note}</p>}<a class="pub-doi" href={'https://doi.org/'+p.doi}>DOI: {p.doi} ↗</a>{coverage && <a class="pub-coverage" href={'/news/#'+coverage.id}>Related coverage</a>}</div></article>;
 })}</section>)}
<p class="pub-figure-note">Select a figure to view it with its original caption. Figures are reproduced in full; only display size and image format are optimized.</p>
<p class="pub-note">Selected publications, not a complete bibliography. Years follow the journal volume where available; online-only articles use the online publication year. For the full record, see <a href="https://scholar.google.com/citations?hl=en&user=pYM2BqsAAAAJ">Google Scholar</a>.</p></div></div>
</Site>
